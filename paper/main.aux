\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Replication scorecard across six papers and three backends. Green = PASS (claim replicated within stated criteria), red = FAIL, grey = not tested on that platform. Both failures are HeH$^+$ VQE claims where coefficient amplification makes hardware noise exceed molecular signal.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:scorecard}{{5}{6}{Replication scorecard across six papers and three backends. Green = PASS (claim replicated within stated criteria), red = FAIL, grey = not tested on that platform. Both failures are HeH$^+$ VQE claims where coefficient amplification makes hardware noise exceed molecular signal}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces H$_2$ potential energy surface on Tuna-9 across the error mitigation ladder. Exact FCI values (black), REM only (grey circles, 5-rep mean $\pm $ std), REM+ZNE quadratic (blue squares), and hybrid VQE with COBYLA optimizer (red star, 0.9\,mHa at $R = 0.735$\,\r A). Green band shows chemical accuracy ($\pm 1.6$\,mHa). ZNE reduces average error from 7.4 to 2.9\,mHa; the hybrid loop achieves chemical accuracy.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:vqe}{{6}{6}{H$_2$ potential energy surface on Tuna-9 across the error mitigation ladder. Exact FCI values (black), REM only (grey circles, 5-rep mean $\pm $ std), REM+ZNE quadratic (blue squares), and hybrid VQE with COBYLA optimizer (red star, 0.9\,mHa at $R = 0.735$\,\AA ). Green band shows chemical accuracy ($\pm 1.6$\,mHa). ZNE reduces average error from 7.4 to 2.9\,mHa; the hybrid loop achieves chemical accuracy}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces LiH mitigation ladder on Tuna-9 ($R = 1.6$\,\r A, $E_\text  {CASCI} = -7.862$\,\text  {Ha}, 5 reps, 4096 shots). Chemical accuracy: 1.6\,mHa.}}{6}{table.7}\protected@file@percent }
\newlabel{tab:lih_mitigation}{{VII}{6}{LiH mitigation ladder on Tuna-9 ($R = 1.6$\,\AA , $E_\text {CASCI} = -7.862$\Ha , 5 reps, 4096 shots). Chemical accuracy: 1.6\,mHa}{table.7}{}}
\citation{cross2019}
\citation{harrigan2021}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces LiH VQE on Tuna-9 (4 qubits, CASCI(2,2), $R = 1.6$\,\r A). \textbf  {Left:} Mitigation ladder showing error reduction from raw (33.1\,mHa) through REM (23.4\,mHa) to REM+ZNE quadratic (6.9\,mHa, 79\% reduction). Error bars show $\pm 1\sigma $ across 5 reps. Dashed green line marks chemical accuracy (1.6\,mHa). \textbf  {Right:} Richardson extrapolation from CZ gate folding at fold factors 1, 3, 5. The fold-energy relationship is monotonic and well-fit by a quadratic, confirming noise scales predictably with gate count. The extrapolated zero-noise energy (red star) recovers $-7.855$\,\text  {Ha}{} vs.\ the CASCI target of $-7.862$\,\text  {Ha}.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:lih}{{7}{7}{LiH VQE on Tuna-9 (4 qubits, CASCI(2,2), $R = 1.6$\,\AA ). \textbf {Left:} Mitigation ladder showing error reduction from raw (33.1\,mHa) through REM (23.4\,mHa) to REM+ZNE quadratic (6.9\,mHa, 79\% reduction). Error bars show $\pm 1\sigma $ across 5 reps. Dashed green line marks chemical accuracy (1.6\,mHa). \textbf {Right:} Richardson extrapolation from CZ gate folding at fold factors 1, 3, 5. The fold-energy relationship is monotonic and well-fit by a quadratic, confirming noise scales predictably with gate count. The extrapolated zero-noise energy (red star) recovers $-7.855$\Ha {} vs.\ the CASCI target of $-7.862$\Ha }{figure.7}{}}
