\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Quantum volume comparison. Dashed line indicates the $2/3$ pass threshold. Both Garnet and Torino achieve QV~$= 32$; Tuna-9 achieves QV~$= 16$. Each point is the mean heavy output fraction over 5 random SU(4) circuit trials, except Tuna-9 at $n=4$ which uses 100 circuits.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:qv}{{4}{5}{Quantum volume comparison. Dashed line indicates the $2/3$ pass threshold. Both Garnet and Torino achieve QV~$= 32$; Tuna-9 achieves QV~$= 16$. Each point is the mean heavy output fraction over 5 random SU(4) circuit trials, except Tuna-9 at $n=4$ which uses 100 circuits}{figure.4}{}}
